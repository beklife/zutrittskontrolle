# Kopieren nach .env und Werte anpassen. Die echte .env niemals committen!

# Domain, unter der die Demo erreichbar ist (DNS muss auf den Server zeigen)
DOMAIN=zutritt.example.com

# Name des Docker-Netzwerks, in dem Traefik läuft
TRAEFIK_NETWORK=traefik

# Name des Let's-Encrypt-Certresolvers in der Traefik-Konfiguration
CERT_RESOLVER=letsencrypt

# Datenbank (nur intern erreichbar, nicht von außen)
POSTGRES_DB=zutritt
POSTGRES_USER=zutritt
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort-setzen
